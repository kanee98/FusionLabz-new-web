{
  "name": "fusionlabz-platform",
  "version": "1.0.0",
  "description": "FusionLabz — High-Tech Software Engineering Platform & Admin CMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "postbuild": "node -e \"console.log('FusionLabz production bundle ready in client/dist')\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16"
  }
}
