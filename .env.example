# Server Configuration (cPanel / Shared Node Hosting sets PORT automatically)
PORT=3000
NODE_ENV=production

# Security (CHANGE THIS IN PRODUCTION — use a random 64-char hex string)
JWT_SECRET=change-this-to-a-long-random-secret-key-before-deploying

# Initial Admin Account (used only on first boot when database.json is created)
ADMIN_EMAIL=admin@fusionlabz.lk
ADMIN_PASSWORD=FusionAdmin@2026

# Optional SMTP Email Notifications (Contact Form & Career Applications)
# Leave blank to store submissions in the Admin Portal without sending email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FusionLabz Portal <no-reply@fusionlabz.lk>"
NOTIFY_EMAIL=hello@fusionlabz.lk
