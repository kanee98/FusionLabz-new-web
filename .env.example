# ==============================================================================
# FusionLabz Production Environment Configuration
# ==============================================================================

# Server Port (cPanel / Shared Node Hosting sets PORT automatically)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# SECURITY CONFIGURATION (IMPORTANT: CUSTOMIZE BEFORE LAUNCH!)
# ------------------------------------------------------------------------------
# Secret Admin Portal Path — DO NOT use /admin! Must start with /
# Example: /flz-console-84k2 (you can change this anytime to your own secret slug)
ADMIN_PATH=/flz-console-84k2

# Strong random 64-character hex string for signing auth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-64-char-random-secret-before-deploying

# Initial Admin Credentials (used on first boot only; change in Admin -> Settings)
ADMIN_EMAIL=connect@fusionlabz.lk
ADMIN_PASSWORD=ChangeMe@FusionLabz2026!

# Optional: Set your production domain to tighten CORS & CSRF checks (e.g. https://fusionlabz.lk)
ALLOWED_ORIGIN=

# ------------------------------------------------------------------------------
# MYSQL DATABASE (Recommended for Shared Hosting / cPanel / Hostinger / Plesk)
# Leave DB_HOST blank to run automatically with local atomic JSON storage
# ------------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# OPTIONAL SMTP EMAIL NOTIFICATIONS (Contact Form & Career Applications)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FusionLabz <connect@fusionlabz.lk>"
NOTIFY_EMAIL=connect@fusionlabz.lk
